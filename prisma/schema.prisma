// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName  String
  email     String   @unique
  clerkId   String   @unique
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stripeId     String?   @unique
  subscription Billings?
  chatBots     ChatBot[]
}

model Billings {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan            Plans     @default(FREE)
  credits         Int       @default(10)
  User            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?   @unique @db.Uuid
  queriesNumber   Int       @default(0)
  lastPaymentDate DateTime?
}

model LeadField {
  id        String   @id @default(cuid())
  fieldName String
  required  Boolean  @default(true)
  chatBotId String?
  chatBot   ChatBot? @relation(fields: [chatBotId], references: [id], onDelete: Cascade)
}

model File {
  id        String   @id @default(cuid())
  fileName  String
  size      BigInt?
  type      String   @default("file")
  fileType  String?
  key       String?
  chatBotId String?
  url       String?
  chatBot   ChatBot? @relation(fields: [chatBotId], references: [id], onDelete: Cascade)
  step      String?  @default("PENDING")
}

model Query {
  id        String   @id @default(cuid())
  query     String
  answer    String
  createdAt DateTime @default(now())
  chatBotId String?
  chatBot   ChatBot? @relation(fields: [chatBotId], references: [id], onDelete: Cascade)
}

model ChatBotLeadsData {
  id        String        @id @default(cuid())
  fieldName String?
  value     String?
  isShow    Boolean       @default(false)
  leadId    String?
  lead      ChatBotLeads? @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model ChatBotLeads {
  id        String             @id @default(cuid())
  leadsData ChatBotLeadsData[]
  createdAt DateTime           @default(now())
  chatBotId String?
  chatBot   ChatBot?           @relation(fields: [chatBotId], references: [id], onDelete: Cascade)
}

model ChatBot {
  id               String         @id @default(cuid())
  origin           String         @default("files")
  assistantId      String?
  title            String         @default("Your chatbot title")
  subTitle         String         @default("")
  description      String         @default("")
  logo             String         @default("")
  theme            String         @default("light")
  leads            Boolean        @default(false)
  language         String         @default("arabic")
  initialMessage   String         @default("Hello, how can I help you?")
  suggestQ         String[]       @default(["I wnat to talk to manager !!!"])
  placeHolder      String         @default("Type your question here...")
  leadFields       LeadField[]
  files            File[]
  queries          Query[]
  chatBotLeads     ChatBotLeads[]
  createdAt        DateTime       @default(now())
  User             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String?        @db.Uuid
  leadsTitle       String         @default("Tell us how to reach you")
  queriesNumber    Int            @default(0)
  HelpDesk         HelpDesk[]
  isRealTimeChat   Boolean        @default(false)
  isHelpDisk       Boolean        @default(false)
  isLead           Boolean        @default(false)
  videosUsage      Int            @default(0)
  fileUsage        BigInt         @default(0)
  webUsage         Int            @default(0)
  useTheme         Boolean        @default(false)
  chatbotTheme     ChatbotTheme?  @relation(fields: [chatbotThemeId], references: [id])
  chatbotThemeId   String?        @unique
  ChatRoom         ChatRoom[]
  buttonBackground String?        @default("#ffff")
  buttonImage      String?
  buttonFullBg     Boolean        @default(false)
  useCustomButton    Boolean        @default(false)
}

model ChatbotTheme {
  id                          String   @id @default(uuid())
  chatbotId                   String   @unique
  chatbot                     ChatBot? @relation
  containerBackground         String   @default("#FFFFFF")
  borderColor                 String   @default("#E2E8F0")
  primaryTextColor            String   @default("#F8FAFC")
  primaryBackground           String   @default("#2563EB")
  botMessageTextColor         String   @default("#020817")
  botMessageBackground        String   @default("#F1F5F9")
  suggestedQuestionTextColor  String   @default("#020817")
  suggestedQuestionBackground String   @default("#FFFFFF")
  textColor                   String   @default("#020817")
  textBackground              String   @default("#F1F5F9")
  placeholderTextColor        String   @default("#64748B")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model HelpDesk {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question  String
  answer    String
  chatbot   ChatBot @relation(fields: [chatBotId], references: [id])
  chatBotId String
}

model ChatRoom {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  live      Boolean?      @default(false)
  chatRead  Boolean?      @default(false)
  mailed    Boolean?      @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  message   ChatMessage[]
  ChatBot   ChatBot       @relation(fields: [chatBotId], references: [id])
  email     String?
  chatBotId String
}

model ChatMessage {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message    String
  role       Role?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  chatRoomId String?   @db.Uuid
  seen       Boolean   @default(false)
  isImage    Boolean   @default(false)
  ChatRoom   ChatRoom? @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
}

enum Plans {
  FREE
  STANDARD
  PRO
  ULTIMATE
}

enum Role {
  user
  assistant
}
